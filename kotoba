<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel Vocabulary Learning</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap');
        
        body {
            font-family: 'Poppins', sans-serif;
            scroll-behavior: smooth;
        }

        .vocab-card:hover {
            transform: translateY(-5px);
            transition: all 0.3s ease;
        }

        .category-tab.active {
            background-color: #1e40af;
            color: white;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800">

    <!-- Header -->
    <header class="bg-blue-900 text-white py-12 px-6 text-center shadow-lg">
        <h1 class="text-4xl font-bold mb-2">Hospitality English</h1>
        <p class="text-blue-200">Kuasai Kosakata Perhotelan dengan Mudah dan Cepat</p>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto p-6">
        
        <!-- Navigation Tabs -->
        <div class="flex flex-wrap justify-center gap-4 mb-10">
            <button onclick="filterCategory('all')" id="tab-all" class="category-tab active px-6 py-2 rounded-full border border-blue-900 font-medium transition-colors">Semua</button>
            <button onclick="filterCategory('front-office')" id="tab-front-office" class="category-tab px-6 py-2 rounded-full border border-blue-900 font-medium transition-colors">Front Office</button>
            <button onclick="filterCategory('housekeeping')" id="tab-housekeeping" class="category-tab px-6 py-2 rounded-full border border-blue-900 font-medium transition-colors">Housekeeping</button>
            <button onclick="filterCategory('fnb')" id="tab-fnb" class="category-tab px-6 py-2 rounded-full border border-blue-900 font-medium transition-colors">Food & Beverage</button>
        </div>

        <!-- Vocabulary Grid -->
        <div id="vocab-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Cards will be injected by JS -->
        </div>

        <!-- Quiz Section -->
        <section class="mt-20 bg-white p-8 rounded-2xl shadow-xl border border-slate-200">
            <div class="text-center mb-8">
                <h2 class="text-3xl font-bold text-blue-900">Uji Kemampuanmu</h2>
                <p class="text-slate-500">Tebak arti dari kata berikut!</p>
            </div>
            
            <div id="quiz-container" class="max-w-md mx-auto text-center">
                <div class="bg-slate-100 p-6 rounded-xl mb-6">
                    <h3 id="quiz-word" class="text-2xl font-bold text-blue-600 mb-2">---</h3>
                    <p class="text-sm text-slate-500 italic">Kategori: <span id="quiz-cat">-</span></p>
                </div>
                
                <div id="quiz-options" class="grid grid-cols-1 gap-3">
                    <!-- Options injected by JS -->
                </div>

                <div id="quiz-feedback" class="mt-4 font-semibold hidden"></div>
                
                <button onclick="generateQuiz()" class="mt-6 text-blue-600 hover:underline font-medium">Lanjut ke kata berikutnya &rarr;</button>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-8 mt-20 text-center">
        <p>&copy; 2024 Pembelajaran Kosakata Perhotelan. Dibuat untuk tujuan edukasi.</p>
    </footer>

    <script>
        const vocabulary = [
            // Front Office
            { word: "Check-in", translation: "Proses pendaftaran kedatangan tamu", category: "front-office", note: "Biasanya memerlukan ID dan kartu kredit." },
            { word: "Reservation", translation: "Pemesanan kamar sebelumnya", category: "front-office", note: "Bisa dilakukan via telepon atau online." },
            { word: "Concierge", translation: "Petugas yang membantu urusan informasi & transportasi", category: "front-office", note: "Ahli dalam rekomendasi lokal." },
            { word: "Vacancy", translation: "Ketersediaan kamar kosong", category: "front-office", note: "Lawan katanya adalah 'No Vacancy'." },
            { word: "Suite", translation: "Kamar dengan ruang tamu terpisah", category: "front-office", note: "Tipe kamar yang lebih mewah." },
            
            // Housekeeping
            { word: "Amenities", translation: "Fasilitas penunjang (sabun, sampo, dll)", category: "housekeeping", note: "Diberikan secara gratis di kamar." },
            { word: "Turn-down Service", translation: "Layanan merapikan tempat tidur sore hari", category: "housekeeping", note: "Biasanya termasuk meletakkan cokelat di bantal." },
            { word: "Linen", translation: "Kain perlengkapan (sprei, handuk, dll)", category: "housekeeping", note: "Harus diganti secara berkala." },
            { word: "Houseman", translation: "Petugas pembersih area publik", category: "housekeeping", note: "Bertanggung jawab atas lobby, lorong, dll." },
            
            // F&B
            { word: "Buffet", translation: "Prasmanan (makan sepuasnya)", category: "fnb", note: "Umum ditemukan saat sarapan." },
            { word: "A la Carte", translation: "Pemesanan makanan per satuan menu", category: "fnb", note: "Harga ditentukan per item." },
            { word: "Complimentary", translation: "Layanan atau barang yang gratis", category: "fnb", note: "Contoh: Air mineral botol di kamar." },
            { word: "Room Service", translation: "Layanan pesan antar makanan ke kamar", category: "fnb", note: "Tersedia 24 jam di banyak hotel bintang 5." }
        ];

        function displayVocab(filter = 'all') {
            const grid = document.getElementById('vocab-grid');
            grid.innerHTML = '';

            const filtered = filter === 'all' ? vocabulary : vocabulary.filter(v => v.category === filter);

            filtered.forEach(item => {
                const card = document.createElement('div');
                card.className = 'vocab-card bg-white p-6 rounded-xl shadow-md border-l-4 border-blue-600';
                card.innerHTML = `
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="text-xl font-bold text-blue-900">${item.word}</h3>
                        <span class="text-[10px] uppercase bg-blue-100 text-blue-700 px-2 py-1 rounded font-bold">${item.category.replace('-', ' ')}</span>
                    </div>
                    <p class="text-slate-700 font-medium mb-2">${item.translation}</p>
                    <p class="text-sm text-slate-500 italic">"${item.note}"</p>
                `;
                grid.appendChild(card);
            });
        }

        function filterCategory(cat) {
            // Update UI tabs
            document.querySelectorAll('.category-tab').forEach(tab => tab.classList.remove('active'));
            document.getElementById(`tab-${cat}`).classList.add('active');
            
            displayVocab(cat);
        }

        // Quiz Logic
        let currentQuizAnswer = "";

        function generateQuiz() {
            const feedback = document.getElementById('quiz-feedback');
            feedback.classList.add('hidden');
            
            const randomItem = vocabulary[Math.floor(Math.random() * vocabulary.length)];
            currentQuizAnswer = randomItem.translation;
            
            document.getElementById('quiz-word').innerText = randomItem.word;
            document.getElementById('quiz-cat').innerText = randomItem.category.toUpperCase();

            // Generate options
            let options = [randomItem.translation];
            while(options.length < 3) {
                let rand = vocabulary[Math.floor(Math.random() * vocabulary.length)].translation;
                if(!options.includes(rand)) options.push(rand);
            }
            options.sort(() => Math.random() - 0.5);

            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = '';
            options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "w-full py-3 px-4 rounded-lg border-2 border-slate-200 hover:border-blue-500 hover:bg-blue-50 transition-all text-left font-medium";
                btn.innerText = opt;
                btn.onclick = () => checkAnswer(opt, btn);
                optionsContainer.appendChild(btn);
            });
        }

        function checkAnswer(selected, element) {
            const feedback = document.getElementById('quiz-feedback');
            feedback.classList.remove('hidden');
            
            if(selected === currentQuizAnswer) {
                feedback.innerText = "Benar! Bagus sekali.";
                feedback.className = "mt-4 font-semibold text-green-600";
                element.classList.add('bg-green-100', 'border-green-500');
            } else {
                feedback.innerText = "Kurang tepat. Coba lagi!";
                feedback.className = "mt-4 font-semibold text-red-600";
                element.classList.add('bg-red-100', 'border-red-500');
            }
        }

        // Initialize
        window.onload = () => {
            displayVocab();
            generateQuiz();
        };
    </script>
</body>
</html>
